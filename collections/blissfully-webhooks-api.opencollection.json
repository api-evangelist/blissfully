{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vendr Catalog Pricing Webhooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Vendr List Webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vendr.com/v1/webhooks"
          },
          "docs": "List all configured webhooks for the authenticated account."
        },
        {
          "info": {
            "name": "Vendr Create Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.vendr.com/v1/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new webhook to receive event notifications from Vendr's data processing pipeline."
        }
      ]
    }
  ],
  "bundled": true
}