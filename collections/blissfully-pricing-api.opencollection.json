{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vendr Catalog Pricing API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pricing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Vendr Get Pricing Insights",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.vendr.com/v1/pricing",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve actionable pricing insights including fair price predictions and negotiation guidance tailored to the buyer's specific requirements, contract size, and company profile. Powered by Vendr's database of real software purchases."
        }
      ]
    }
  ],
  "bundled": true
}