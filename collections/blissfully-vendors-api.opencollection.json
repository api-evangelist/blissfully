{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vendr Catalog Pricing Vendors API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Vendors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Vendr List Software Vendors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vendr.com/v1/vendors",
            "params": [
              {
                "name": "category",
                "value": "CRM",
                "type": "query",
                "description": "Filter vendors by category"
              },
              {
                "name": "limit",
                "value": "20",
                "type": "query",
                "description": "Maximum number of results"
              },
              {
                "name": "offset",
                "value": "0",
                "type": "query",
                "description": "Offset for pagination"
              }
            ]
          },
          "docs": "List software vendors in the Vendr catalog with their product portfolios and vendor profile information."
        }
      ]
    }
  ],
  "bundled": true
}